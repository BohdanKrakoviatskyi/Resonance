{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Resonance",
  "mainBinaryName": "resonance",
  "version": "0.4.13",
  "identifier": "com.resonance.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resonance",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      },
      {
        "label": "splash",
        "title": "Resonance",
        "url": "index.html?splash=1",
        "width": 380,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; media-src 'self' https: blob: http://127.0.0.1:*; connect-src 'self' https: http://127.0.0.1:*; script-src 'self' https://www.youtube.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; frame-src https://www.youtube.com; font-src 'self' data: https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/local-api",
      "binaries/ytmusic-worker"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyMkFCNjNBODZGRkE1RDkKUldUWnBmK0dPcllxQXZ6em5vcnhaOStqOGQ4VDJ4T2NXYitocXUyMS94VE03MCtZZ3VEeWZ2OHMK",
      "endpoints": [
        "https://github.com/BohdanKrakoviatskyi/Resonance/releases/latest/download/latest.json"
      ]
    }
  }
}
